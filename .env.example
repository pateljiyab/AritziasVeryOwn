# Copy to .env and fill in what you use. Nothing here is required to run the tests.

# Channel3 product API, for jobs/collect_channel3.py.
CHANNEL3_API_KEY=

# Chat parsing with Claude Haiku 5.5. Without it, the app uses LLM_* below, else keyword rules.
ANTHROPIC_API_KEY=

# Any OpenAI-compatible server, used when ANTHROPIC_API_KEY is empty (and by jobs/parser_report.py).
# Groq's free tier:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
# A local Ollama model (`ollama pull llama3.1:8b`, then `ollama serve`); the key can be anything:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1:8b
